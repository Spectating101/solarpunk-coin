{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarPunk Constraint Evidence Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter", "source", "intervals", "summary", "capabilities", "evidence_hash", "hash_algorithm"],
  "properties": {
    "schema": { "const": "solarpunk.constraint.evidence_envelope.v1" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": { "type": "object" },
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "meter_id",
          "site_id",
          "window_start",
          "window_end",
          "generation_kwh",
          "site_load_kwh",
          "export_kwh",
          "curtailed_kwh",
          "eligible_surplus_kwh",
          "surplus_basis",
          "quality_score",
          "source"
        ],
        "properties": {
          "meter_id": { "type": ["string", "null"] },
          "site_id": { "type": ["string", "null"] },
          "window_start": { "type": "string", "format": "date-time" },
          "window_end": { "type": "string", "format": "date-time" },
          "generation_kwh": { "type": ["number", "null"], "minimum": 0 },
          "site_load_kwh": { "type": ["number", "null"], "minimum": 0 },
          "export_kwh": { "type": ["number", "null"], "minimum": 0 },
          "curtailed_kwh": { "type": ["number", "null"], "minimum": 0 },
          "eligible_surplus_kwh": { "type": "number", "minimum": 0 },
          "surplus_basis": { "type": "string", "minLength": 1 },
          "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "status", "detail"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "WARNING", "BLOCK"] },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "summary": {
      "type": "object",
      "required": ["interval_count", "total_eligible_surplus_kwh", "blocker_count", "warning_count"],
      "properties": {
        "interval_count": { "type": "integer", "minimum": 0 },
        "total_eligible_surplus_kwh": { "type": "number", "minimum": 0 },
        "blocker_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "rejected_input_records": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "meta": { "type": "object" },
    "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash_algorithm": { "const": "SHA-256" }
  }
}
