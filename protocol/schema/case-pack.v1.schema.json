{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarPunk Constraint Case Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_pack_id",
    "domain",
    "purpose",
    "empirical_claim",
    "case_ids",
    "case_files",
    "context_files",
    "evidence_files",
    "provenance_scenario_files",
    "policy_ids",
    "boundary"
  ],
  "properties": {
    "schema": { "const": "solarpunk.constraint.case_pack.v1" },
    "case_pack_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "empirical_claim": { "type": "boolean" },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "case_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "context_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "provenance_scenario_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "policy_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
