{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarPunk Constraint Claim Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "decision_id",
    "case_id",
    "subject",
    "evidence_hashes",
    "policy_id",
    "policy_version",
    "policy_manifest_hash",
    "quantity",
    "quantity_base_units",
    "quantity_decimals",
    "unit",
    "decision",
    "state",
    "blockers",
    "warnings",
    "settlement_capacity_required",
    "history"
  ],
  "properties": {
    "schema": { "const": "solarpunk.constraint.claim_manifest.v2" },
    "claim_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case_id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "evidence_hashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "uniqueItems": true
    },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "policy_manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "quantity": { "type": "number", "exclusiveMinimum": 0 },
    "quantity_base_units": { "type": "string", "pattern": "^[0-9]+$" },
    "quantity_decimals": { "type": "integer", "minimum": 0, "maximum": 18 },
    "unit": { "type": "string", "minLength": 1 },
    "decision": { "const": "ADMIT_WITH_LIMIT" },
    "state": {
      "enum": [
        "ADMITTED",
        "ISSUABLE",
        "ISSUED",
        "ACTIVE",
        "SETTLEMENT_DUE",
        "SETTLED",
        "PARTIAL",
        "SHORTFALL",
        "DISPUTED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "blockers": { "type": "array", "maxItems": 0 },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "settlement_capacity_required": { "type": "boolean" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "from", "to", "reason", "actor"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "reason": { "type": ["string", "null"] },
          "actor": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issued_quantity": { "type": "number", "exclusiveMinimum": 0 },
    "issued_quantity_base_units": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
