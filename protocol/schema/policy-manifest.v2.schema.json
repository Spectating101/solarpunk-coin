{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarPunk Constraint Policy Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "description",
    "admission_rules",
    "quantity_rules",
    "settlement",
    "governance"
  ],
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "calculator_id", "parameters"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "calculator_id": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    }
  },
  "properties": {
    "schema": { "const": "solarpunk.constraint.policy_manifest.v2" },
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "admission_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "quantity_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_capacity_required", "legal_redemption_not_implied"],
      "properties": {
        "explicit_capacity_required": { "type": "boolean" },
        "legal_redemption_not_implied": { "type": "boolean" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "mutable_by"],
      "properties": {
        "authority": { "type": ["string", "null"] },
        "mutable_by": { "type": ["string", "null"] }
      }
    }
  }
}
