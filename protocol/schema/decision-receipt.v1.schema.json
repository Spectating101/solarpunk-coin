{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarPunk Constraint Decision Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "case_id",
    "evaluated_at",
    "policy",
    "evidence",
    "contexts",
    "runtime",
    "evaluated_rules",
    "blocking_rules",
    "binding_constraints",
    "result",
    "data_boundary"
  ],
  "properties": {
    "schema": { "const": "solarpunk.constraint.decision_receipt.v1" },
    "decision_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case_id": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hash", "raw_included"],
        "properties": {
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "raw_included": { "type": "boolean" }
        }
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hash"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "package_version", "source_revision"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "package_version": { "type": ["string", "null"] },
        "source_revision": { "type": "string", "minLength": 1 }
      }
    },
    "evaluated_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evaluation_id",
          "calculator_id",
          "calculator_version",
          "policy_rule_id",
          "constraint_class",
          "status"
        ],
        "properties": {
          "evaluation_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "calculator_id": { "type": "string", "minLength": 1 },
          "calculator_version": { "type": "string", "minLength": 1 },
          "policy_rule_id": { "type": ["string", "null"] },
          "constraint_class": {
            "enum": ["ADMISSION_GATE", "QUANTITY_CEILING", "SETTLEMENT_CONSTRAINT"]
          },
          "status": { "enum": ["PASS", "BLOCK", "WARNING", "NOT_APPLICABLE"] }
        }
      }
    },
    "blocking_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "binding_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "result": { "enum": ["BLOCKED", "ADMIT_WITH_LIMIT"] },
    "data_boundary": { "type": "string", "minLength": 1 }
  }
}
