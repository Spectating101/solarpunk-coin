{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarPunk Constraint Case Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "subject",
    "case_type",
    "spatial_identity",
    "measurement_window",
    "evidence_refs",
    "context_refs",
    "default_policy_ref",
    "boundaries"
  ],
  "properties": {
    "schema": { "const": "solarpunk.constraint.case_manifest.v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "case_type": { "type": "string", "minLength": 1 },
    "spatial_identity": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["site_id", "latitude", "longitude", "spatial_reference"],
          "properties": {
            "site_id": { "type": ["string", "null"] },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "spatial_reference": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "measurement_window": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "context_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "default_policy_ref": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "boundaries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
