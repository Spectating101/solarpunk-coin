{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarPunk Constraint Policy Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "description",
    "min_provenance_level",
    "admission",
    "issuance",
    "settlement",
    "governance"
  ],
  "properties": {
    "schema": { "const": "solarpunk.constraint.policy_manifest.v1" },
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "min_provenance_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_positive_surplus",
        "require_zero_blockers",
        "require_signed_evidence",
        "require_external_corroboration"
      ],
      "properties": {
        "require_positive_surplus": { "type": "boolean" },
        "require_zero_blockers": { "type": "boolean" },
        "require_signed_evidence": { "type": "boolean" },
        "require_external_corroboration": { "type": "boolean" }
      }
    },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "decimals", "rate_per_surplus_kwh", "haircut_pct", "absolute_cap"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 18 },
        "rate_per_surplus_kwh": { "type": "number", "minimum": 0 },
        "haircut_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "absolute_cap": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_capacity_required", "legal_redemption_not_implied"],
      "properties": {
        "explicit_capacity_required": { "type": "boolean" },
        "legal_redemption_not_implied": { "type": "boolean" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "mutable_by"],
      "properties": {
        "authority": { "type": ["string", "null"] },
        "mutable_by": { "type": ["string", "null"] }
      }
    }
  }
}
